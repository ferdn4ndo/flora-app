# Leave empty in development so the browser calls same-origin `/v1/...`
# and Vite proxies to Flora Hive (see vite.config.ts).
# In production, set to your Hive API origin, e.g. https://hive.example.com
VITE_FLORA_HIVE_URL=

# Dev server only: proxy target for /v1 and /healthz
VITE_DEV_FLORA_HIVE_PROXY_TARGET=http://localhost:8080



# target deployment bucket
S3_BUCKET=

# local folder to upload (default: dist)
DIST_DIR=dist

# AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# region for the bucket (recommended if not in default config)
AWS_REGION=us-east-1

# optional key prefix, e.g. "app/" (no leading slash)
S3_PREFIX=

# if set, create invalidation for /* after upload
CLOUDFRONT_ID=